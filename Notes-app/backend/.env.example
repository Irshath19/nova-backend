APP_NAME=NOVA
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# PostgreSQL + pgvector Database URL (Port 5434 for local Docker container)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/nova
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5434/nova

# Redis & Celery Queue
REDIS_URL=redis://localhost:6379/0

# Security & JWT Tokens
JWT_SECRET=supersecretjwtkey_change_me_in_production_min_32_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider Selection: "gemini" | "openai" | "ollama"
AI_PROVIDER=gemini

# 1. Google Gemini (Free Tier API Key from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 2. OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 3. Ollama (Optional Local-First)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
